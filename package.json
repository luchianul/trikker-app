{
  "name": "trikker-app",
  "version": "1.0.0",
  "description": "VerTech - plan casa si schema unifilara",
  "main": "electron/main.js",
  "author": "Diaz Electricite",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@capacitor/android": "6.2.0",
    "@capacitor/browser": "6.0.5",
    "@capacitor/cli": "6.2.0",
    "@capacitor/core": "6.2.0",
    "@capacitor/filesystem": "6.0.2",
    "@capacitor/share": "6.0.3"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.diazelectricite.trikker",
    "productName": "VerTech",
    "files": [
      "electron/**",
      "www/**",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}